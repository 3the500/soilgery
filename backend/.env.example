# ── 로컬 개발용 기본 설정 ──────────────────────────────
# DATABASE_URL을 비워두면(또는 이 줄을 지우면) 자동으로 로컬 SQLite(soilgery.db 파일)를 사용합니다.
# 즉, 처음 로컬에서 실행할 때는 아래 줄을 그대로 두면 됩니다 -> 별도 DB 설치/실행 없이 바로 회원가입/로그인 가능
DATABASE_URL=sqlite:///./soilgery.db

# ※ 실제 배포(Railway) 시에는 이 .env.example이 아니라 Railway 대시보드의 환경변수에
#    PostgreSQL 접속 주소(DATABASE_URL)를 따로 설정합니다. 로컬 .env 파일과는 무관합니다.

SECRET_KEY=your-secret-key-here-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
ANTHROPIC_API_KEY=your-anthropic-api-key-here
